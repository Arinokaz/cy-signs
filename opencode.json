{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "watcher": {
    "ignore": ["environments/**", "uploads/**", "vendor/**", ".docker/**", ".git/**"]
  },
  "model": "minimax/MiniMax-M3",
  "small_model": "minimax/MiniMax-M2.7",
  "permission": {
    "*": "ask",
    "glob": "allow",
    "read": "allow",
    "grep": "allow",
    "websearch": "allow",
    "webfetch": "ask",
    "doom_loop": "ask",
    "edit": {
      "*": "ask"
    },
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "git *": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git push": "deny",
      "git push *": "deny",
      "git pull": "deny",
      "git pull *": "deny",
      "git remote": "deny",
      "git remote *": "deny",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "pwd": "allow",
      "rm *": "deny"
    }
  }
}